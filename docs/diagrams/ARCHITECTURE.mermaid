graph TB

%% =========================
%% Presentation Layer
%% =========================
subgraph Presentation["Presentation Layer"]
    UI["Chat Interface"]
    Files["Generated .docx Files"]
end

%% =========================
%% API Layer
%% =========================
subgraph API["API Layer"]
    ChatAPI["Chat API"]
    FileAPI["File API"]
end

%% =========================
%% Orchestration Layer
%% =========================
subgraph Orch["Orchestration Layer"]
    ChatOrch["ChatOrchestrator<br/>(Conversation Manager)"]
    LangGraph["LangGraphOrchestrator<br/>(Plan → Write → Review → Generate)"]
end

%% =========================
%% AI Agents
%% =========================
subgraph Agents["AI Agent Layer"]
    Planner["Planner Agent"]
    Writer["Writer Agent"]
    Reviewer["Reviewer Agent"]
end

%% =========================
%% Knowledge Layer
%% =========================
subgraph Knowledge["Knowledge Layer (RAG)"]
    Embed["SentenceTransformer<br/>all-MiniLM-L6-v2"]
    Milvus["Milvus Vector Database"]
    Context["Retrieved Curriculum Context"]
end

%% =========================
%% LLM Layer
%% =========================
subgraph LLM["LLM Layer"]
    Ollama["Ollama"]
end

%% =========================
%% Document Generation
%% =========================
subgraph Docs["Document Generation"]
    Structure["DocumentStructure"]
    Markdown["MarkdownFormatter"]
    DOCX["DOCXGenerator"]
    Word["Microsoft Word (.docx)"]
end

%% =========================
%% Future Components
%% =========================
subgraph Future["Future Integration"]
    Extractor["Progress Extractor"]
    State["Student State"]
    Validator["Progress Validator"]
    SAP["State-Aware Planner"]
end

%% =========================
%% Flow
%% =========================

UI --> ChatAPI

ChatAPI --> ChatOrch
ChatAPI --> LangGraph

ChatOrch --> Ollama

LangGraph --> Planner

Planner --> Embed
Embed --> Milvus
Milvus --> Context
Context --> Planner

Planner --> Ollama

Planner --> Writer

Writer --> Ollama

Writer --> Structure

Structure --> Reviewer

Reviewer -->|Approved| Markdown
Reviewer -->|Revision Needed| Writer

Markdown --> DOCX
DOCX --> Word

Word --> FileAPI
FileAPI --> Files

%% Future
Extractor -.-> State
State -.-> SAP
Validator -.-> SAP

style Future fill:#eeeeee,stroke:#888888,stroke-dasharray: 5 5