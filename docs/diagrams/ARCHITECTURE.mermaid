flowchart TB

%% ==========================================================
%% Frontend
%% ==========================================================
subgraph CLIENT["Frontend (React)"]
    Profiles["Profiles<br/>Create · Switch · Delete"]
    Workspace["Workspace<br/>Notes · Knowledge base · Ingest"]
    Roadmap["Knowledge Graph / Roadmap<br/>edit · rebuild"]
    Planner["Planner · Search · Review"]
    Tutor["Tutor (chatbot)<br/>Answer | Generate document"]
    ModelSel["Model selector<br/>cloud / local"]
end

API["FastAPI Backend"]

CLIENT -->|REST / multipart| API
API --> CLIENT
Tutor -->|Generate document| DocAgent
API -->|.docx download| Tutor

%% ==========================================================
%% Backend Services
%% ==========================================================
subgraph BACKEND["Backend Services"]

    WorkspaceSvc["Workspace Service"]
    Ingest["Document Ingestion"]
    Retrieve["Retrieval Service"]
    Rerank["Reranker"]
    Graph["Knowledge Graph Pipeline"]
    Study["Study Content Agents<br/>Planner · Flashcards · Subjects"]
    DocAgent["Document Orchestrator (LangGraph)<br/>Plan → Write → Review → Refine → DOCX"]
    ChatAgent["Chat Orchestrator"]
    DocStore["Generated .docx files<br/>/files · /download"]

end

API --> WorkspaceSvc
API --> Ingest
API --> Retrieve
API --> DocAgent
API --> ChatAgent
API --> Study

Retrieve --> Rerank
DocAgent --> DocStore
DocStore -->|download| API

%% ==========================================================
%% PostgreSQL
%% ==========================================================
subgraph PG["PostgreSQL"]

ProfilesDB[("Profiles")]
WorkspaceDB[("Workspaces")]
DocsDB[("Documents")]
MetaDB[("Planner<br/>Flashcards<br/>Tasks<br/>Memory<br/>Events<br/>Knowledge Graph")]

end

WorkspaceSvc --> ProfilesDB
WorkspaceSvc --> WorkspaceDB
WorkspaceSvc --> DocsDB
WorkspaceSvc --> MetaDB

%% ==========================================================
%% Document Ingestion
%% ==========================================================
subgraph PIPE["Document Pipeline"]

Parse["Parse"]
Chunk["Chunk"]
Embed["Embedding Model"]

end

Ingest --> Parse
Parse --> Chunk
Chunk --> Embed

%% ==========================================================
%% Vector Database
%% ==========================================================
subgraph VDB["Milvus"]

Vectors[("learning_profile_chunks")]

end

Embed --> Vectors
Retrieve -->|ANN + Metadata Filter| Vectors
Vectors --> Rerank
Vectors --> Graph

%% ==========================================================
%% AI Models
%% ==========================================================
subgraph LLM["LLM (OpenAI / Ollama / GPT-OSS)"]

PlannerAgent["Planner Agent"]
WriterAgent["Writer Agent"]
ReviewerAgent["Reviewer Agent"]
TutorAgent["Tutor Agent"]
TodoAgent["Todo Agent"]
ChatLLM["Conversation Agent"]

ConceptAgent["Concept Extractor"]
PrereqAgent["Prerequisite Mapper"]
KnowledgeAgent["Knowledge Graph Agent"]

end

DocAgent --> PlannerAgent
PlannerAgent --> WriterAgent
WriterAgent --> ReviewerAgent
ReviewerAgent -->|issues · iterate < 2| WriterAgent

ChatAgent --> ChatLLM
DocAgent --> TodoAgent
Retrieve --> TutorAgent

%% Study-content generators: planner tree, flashcards, subjects
Study --> StudyPlanner["Study Planner Agent"]
Study --> FlashAgent["Flashcard Agent"]
StudyPlanner --> MetaDB
FlashAgent --> MetaDB
Study -->|subjects - deterministic| MetaDB

Graph --> ConceptAgent
ConceptAgent --> PrereqAgent
PrereqAgent --> KnowledgeAgent

KnowledgeAgent --> MetaDB

%% ==========================================================
%% Styling
%% ==========================================================
classDef client fill:#7451bf22,stroke:#7451bf,stroke-width:1.5px;
classDef backend fill:#0c8fa218,stroke:#0c8fa2,stroke-width:1.5px;
classDef storage fill:#2f6db018,stroke:#2f6db0,stroke-width:1.5px;
classDef vector fill:#c9642a18,stroke:#c9642a,stroke-width:1.5px;
classDef ai fill:#2f9e6b18,stroke:#2f9e6b,stroke-width:1.5px;

class Profiles,Workspace,Roadmap,Planner,Tutor,ModelSel client;
class API,WorkspaceSvc,Ingest,Retrieve,Rerank,Graph,Study,DocAgent,ChatAgent,DocStore,Parse,Chunk,Embed backend;
class ProfilesDB,WorkspaceDB,DocsDB,MetaDB storage;
class Vectors vector;
class PlannerAgent,WriterAgent,ReviewerAgent,TutorAgent,TodoAgent,ChatLLM,ConceptAgent,PrereqAgent,KnowledgeAgent,StudyPlanner,FlashAgent ai;