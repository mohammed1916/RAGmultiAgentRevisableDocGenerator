# Ollama Configuration
# Choose mode: "local" or "cloud"
OLLAMA_MODE=local

# For LOCAL mode:
# OLLAMA_MODE=local
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# For CLOUD mode (Ollama Cloud):
# OLLAMA_MODE=cloud
# OLLAMA_KEY=your-ollama-cloud-api-key
# OLLAMA_BASE_URL=https://api.ollama.ai (or your cloud endpoint)
# OLLAMA_MODEL=mistral (or other cloud-available model)

# Local Ollama Configuration (used when OLLAMA_MODE=local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300

# Cloud Ollama Configuration (used when OLLAMA_MODE=cloud)
# OLLAMA_KEY=your-api-key-here
# For cloud, get your API key from: https://ollama.ai/account

# Application Configuration
LOG_LEVEL=INFO

# Server (used by run_server.py / server.main)
APP_HOST=0.0.0.0
APP_PORT=8000
# Set APP_RELOAD=true only for local development.
APP_RELOAD=false
# Number of worker processes for production (ignored when APP_RELOAD=true).
WEB_CONCURRENCY=1

# CORS: comma-separated allowlist of browser origins. Do not use "*" in
# production (it disables credentialed cross-origin requests).
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# PostgreSQL (Learning OS persistence) - REQUIRED
# Either set DATABASE_URL directly:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/learning_os
# ...or provide the individual parts (used only if DATABASE_URL is unset):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=learning_os

# Milvus (vector DB for RAG)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# LangSmith Configuration (Optional)
# Enable tracing and observability with LangSmith
# Get API key from: https://smith.langchain.com/
LANGSMITH_ENABLED=false
# LANGSMITH_API_KEY=ls_your-api-key-here
LANGSMITH_PROJECT=specbot-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
