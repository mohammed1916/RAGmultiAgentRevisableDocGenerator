# Ollama Configuration
# Choose mode: "local" or "cloud"
OLLAMA_MODE=local

# For LOCAL mode:
# OLLAMA_MODE=local
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# For CLOUD mode (Ollama Cloud):
# OLLAMA_MODE=cloud
# OLLAMA_KEY=your-ollama-cloud-api-key
# OLLAMA_BASE_URL=https://api.ollama.ai (or your cloud endpoint)
# OLLAMA_MODEL=mistral (or other cloud-available model)

# Local Ollama Configuration (used when OLLAMA_MODE=local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300

# Cloud Ollama Configuration (used when OLLAMA_MODE=cloud)
# OLLAMA_KEY=your-api-key-here
# For cloud, get your API key from: https://ollama.ai/account

# Application Configuration
LOG_LEVEL=INFO
